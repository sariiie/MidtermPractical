@implements IDisposable
@inject AuthService Auth
@inject GameSession Session
@inject NavigationManager Nav

<header class="border-b-4 border-edge bg-panel">
    <nav class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-3">
        <a href="/" class="flex items-center gap-2 font-display text-lg text-sun">
            <span class="text-2xl">🕹️</span>
            TriviaMaster
        </a>

        @if (Auth.CurrentUser is not null)
        {
            <div class="order-last flex w-full flex-wrap justify-center gap-1 sm:order-none sm:w-auto sm:flex-1">
                <NavLink href="/" Match="NavLinkMatch.All" class="@LinkClass" ActiveClass="@ActiveClass">Play</NavLink>
                <NavLink href="/leaderboard" class="@LinkClass" ActiveClass="@ActiveClass">Leaderboard</NavLink>
                <NavLink href="/how-to-play" class="@LinkClass" ActiveClass="@ActiveClass">How to play</NavLink>
            </div>
        }

        <div class="flex items-center gap-2 sm:gap-3">
            @if (Auth.IsInitialized)
            {
                @if (Auth.CurrentUser is { } user)
                {
                    <NavLink href="/profile" class="@ChipClass" ActiveClass="@ChipActiveClass" title="Your profile" aria-label="Your profile">
                        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-sun text-lg">@user.Avatar</span>
                        <span class="hidden max-w-32 truncate font-bold sm:inline">@user.DisplayName</span>
                    </NavLink>

                    @if (user.IsGuest)
                    {
                        <a href="/register" class="chunk-sm chunk-btn rounded-xl bg-sun px-4 py-2 font-bold text-ink">Sign up</a>
                    }

                    <button type="button" @onclick="LogoutAsync"
                            class="chunk-sm chunk-btn rounded-xl bg-panel-hi px-4 py-2 font-bold">
                        Log out
                    </button>
                }
                else
                {
                    <a href="/login" class="chunk-sm chunk-btn rounded-xl bg-panel-hi px-4 py-2 font-bold">Log in</a>
                    <a href="/register" class="chunk-sm chunk-btn rounded-xl bg-sun px-4 py-2 font-bold text-ink">Register</a>
                }
            }
        </div>
    </nav>
</header>

@code {
    private const string LinkClass = "rounded-xl px-3 py-2 text-sm font-bold hover:underline sm:text-base";
    private const string ActiveClass = "bg-sun text-ink chunk-sm";

    private const string ChipClass = "chunk-sm chunk-btn flex items-center gap-2 rounded-full bg-panel-hi py-1 pl-1 pr-2 sm:pr-4";
    private const string ChipActiveClass = "ring-4 ring-sun";

    protected override void OnInitialized() => Auth.OnChange += Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);

    private async Task LogoutAsync()
    {
        Session.Reset();
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login");
    }

    public void Dispose() => Auth.OnChange -= Refresh;
}